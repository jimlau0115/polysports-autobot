# ==========================================
# PolySports Quant 70%+ 自動交易系統環境設定
# ==========================================

# 伺服器埠號 (Railway 會自動注入 PORT)
PORT=8080
HOST=0.0.0.0

# 預設交易模式: PAPER (模擬交易) 或 LIVE (Polymarket CLOB 真實下單)
TRADING_MODE=PAPER

# 盤口數據源: AUTO (優先官方 Gamma API，離線自動切換模擬) | LIVE_API | SIMULATION
DATA_SOURCE_MODE=AUTO

# 背景掃描間隔 (秒)
SCAN_INTERVAL_SEC=5

# 核心 70%+ 勝率策略與風控參數
MIN_WIN_PROB=0.70
MAX_WIN_PROB=0.95
BET_AMOUNT_USDC=25.0
MIN_LIQUIDITY_USDC=1500.0
MIN_VOLUME_USDC=5000.0
MAX_SPREAD=0.05
DAILY_BUDGET_USDC=300.0
MAX_OPEN_POSITIONS=15
TAKE_PROFIT_PROB=0.96
STOP_LOSS_PROB=0.52
ALLOWED_SPORTS=ALL
PAPER_INITIAL_BALANCE=1000.0

# ==========================================
# Polymarket CLOB 真實自動下單憑證 (LIVE 模式必填)
# 亦可直接在網站右上角「CLOB 錢包設定」介面中輸入
# ==========================================
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
# 0 = EOA 直接錢包, 1 = Polymarket Proxy (Email/Magic 登入), 2 = Gnosis Safe Proxy
POLY_SIGNATURE_TYPE=1
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
